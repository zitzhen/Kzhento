# Kzhento notification branding (untranslated source language).
# Rebinds the Kubuntu-specific strings to the K-Zhento product name.
msgid ""
msgstr ""
"Project-Id-Version: Kzhento notification branding\n"
"PO-Revision-Date: 2026-11-22 00:00+0800\n"
"Last-Translator: Oliver Lin <oliver@liuxiaozhen.dev>\n"
"Language-Team: Kzhento <oliver@liuxiaozhen.dev>\n"
"Language: en\n"
"MIME-Version: 1.0\n"
